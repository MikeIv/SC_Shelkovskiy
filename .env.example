# Публичные переменные окружения (префикс NUXT_PUBLIC_ попадает на клиент).

# Режим данных выбирает NUXT_PUBLIC_API_BASE:
#
# 1) Прокси (по умолчанию): пусто или относительный путь. Клиент зовёт свои ручки /api/*,
#    а Nitro идёт в Laravel с Basic из NUXT_API_UPSTREAM / NUXT_API_AUTH.
#      NUXT_PUBLIC_API_BASE=
#      NUXT_PUBLIC_API_BASE=/api
#
# 2) Прямой: абсолютный URL API — режим статического хостинга (серверных ручек нет).
#    Браузер идёт в Laravel напрямую, поэтому API должен разрешить CORS для origin стенда.
#    Basic в этом режиме не работает: секрет попал бы в клиентский бандл. Картинки
#    отдаются с API как есть — ipx в этой сборке отключается.
#      NUXT_PUBLIC_API_BASE=https://schelkovsky-backend-main.grandfs-develop.ru/api/v1
#
# Пререндер статики обходит сотни страниц, а Laravel режет запросы по IP (429 +
# Retry-After). Серверные запросы сами ждут окно лимита — см. `shared/api/throttle.ts`.
NUXT_PUBLIC_API_BASE=

# Требовать источник данных на сборке (`nuxt build` / `nuxt generate`): без абсолютного
# NUXT_PUBLIC_API_BASE или NUXT_API_UPSTREAM сборка падает, а не выпускает витрину на моках.
# Ставит job сборки в .gitlab-ci.yml. На `nuxt prepare` из postinstall и на `nuxt dev`
# проверка не срабатывает: там источника данных ещё нет по определению.
# NUXT_REQUIRE_API_SOURCE=1

# Ключ JS API Яндекс.Карт 3.0 (кабинет разработчика).
# Без ключа модуль не подключается — на «Как добраться» виджет-iframe.
# С ключом — vue-yandex-maps (нужен перезапуск `pnpm dev`).
# NUXT_PUBLIC_YANDEX_MAPS_APIKEY=
NUXT_PUBLIC_YANDEX_MAPS_APIKEY=

# Приватные переменные (без NUXT_PUBLIC_ — на клиент не попадают).
# База Laravel API без завершающего слэша. Нужна только в режиме прокси.
# NUXT_API_UPSTREAM=https://example.invalid/api/v1
NUXT_API_UPSTREAM=

# Basic auth стенда, формат login:password. Из него собирается Authorization для Nitro-прокси.
NUXT_API_AUTH=

# Basic для ipx: значение целиком, JSON-объектом заголовков — `{"Authorization":"Basic <base64(login:password)>"}`.
# Только рантайм, чтобы секрет не попадал в собранный серверный бандл. Вложенное имя
# (`..._HEADERS_AUTHORIZATION`) не работает: Nitro применяет env только к существующим ключам.
# Без этого заголовка приватные `/storage` стенда через ipx дают 401/403.
NUXT_IPX_HTTP_FETCH_OPTIONS_HEADERS=

# Афиша — раздел «Кино» на главной. Партнёрский ключ читает только Nitro (заголовок
# X-ApiAuth-PartnerKey): вендор запрещает вызовы API с клиента, а сам API закрыт белым
# списком IP. Без ключа ручка /api/cinema отвечает 503, раздел показывает заглушки.
# NUXT_AFISHA_PARTNER_KEY=
NUXT_AFISHA_PARTNER_KEY=

# Кинотеатр ТРЦ в Афише. id города/площадки можно задать явно; иначе ручка ищет
# Москву в справочнике городов и площадку по вхождению в название (NUXT_AFISHA_PLACE_NAME).
# NUXT_AFISHA_CITY_ID=2
# NUXT_AFISHA_PLACE_ID=
NUXT_AFISHA_CITY_ID=
NUXT_AFISHA_PLACE_ID=
NUXT_AFISHA_PLACE_NAME=ОККО

# Публичный ключ виджета Афиши. По умолчанию — ключ из договора (см. nuxt.config).
# NUXT_PUBLIC_AFISHA_WIDGET_KEY=
